    {
      "type": "color_background",
      "id": "gradient_color",
      "label": "Gradient Color",
      "default": "linear-gradient(133deg, rgba(250, 220, 54, 1) 11%, rgba(254, 98, 146, 1) 49%, rgba(250, 220, 54, 1) 87%)"
    },
    {
      "type": "checkbox",
      "id": "enable_highlight_gradient",
      "label": "Enable Highlight Text Gradient",
      "default": false
