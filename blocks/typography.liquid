{% liquid
    assign sectionId = block.id
    assign settings = block.settings

    assign fontSizeDesktop = settings.font_size_desktop | default: 16
    assign fontSizeMobile = settings.font_size_mobile | default: 16
    assign fontWeight = settings.font_weight | default: 400
    if settings.font_style_italic
        assign fontStyleItalic = "italic"
    else
        assign fontStyleItalic = "normal"
    endif
    assign letterSpacing = settings.letter_spacing | default: 0

    assign enableTextGradient = settings.enable_text_gradient | default: false
    assign gradientColor = settings.gradient_color | default: "linear-gradient(133deg, rgba(250, 220, 54, 1) 11%, rgba(254, 98, 146, 1) 49%, rgba(250, 220, 54, 1) 87%)"

    assign textAlign = settings.text_align | default: "left"

    # Box
    assign enableHighlightGradient = settings.enable_highlight_gradient | default: false
    assign highlightGradient = settings.highlight_gradient | default: 'linear-gradient(90deg, rgba(183, 227, 74, 1) 0%, rgba(76, 175, 80, 1) 55%, rgba(247, 224, 75, 1) 100%)'
    assign borderWidth = settings.border_width | default: 0
    assign borderStyle = settings.border_style | default: 'solid'
    assign borderColor = settings.border_color | default: '#e5e5e5'
    assign borderRadius = settings.border_radius | default: 0
    assign paddingVertical = settings.padding_vertical | default: 0
    assign paddingHorizontal = settings.padding_horizontal | default: 0
%}

{% style %}
#{{ sectionId }}.typography {
    text-align: {{ textAlign }};
    padding: {{ paddingVertical }}px {{ paddingHorizontal }}px;
    border: {{ borderWidth }}px {{ borderStyle }} {{ borderColor }};
    border-radius: {{ borderRadius }}px;
    {%- if enableTextGradient %}
        background: transparent;
    {%- else %}
        background: {{ gradientColor }};
    {%- endif %}
    font-size: clamp({{ fontSizeMobile }}px, 2.5vw, {{ fontSizeDesktop }}px);
    line-height: 1.5;
    font-weight: {{ fontWeight }};
    font-style: {{ fontStyleItalic }};
    letter-spacing: {{ letterSpacing }}px;
    color: inherit;
}

#{{ sectionId }}.typography p {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    font-weight: inherit;
    font-style: inherit;
    letter-spacing: inherit;
}

#{{ sectionId }}.typography strong {
    {%- unless enableHighlightGradient %}
        background: {{ highlightGradient }};
    {%- endunless %}
}

{%- if enableHighlightGradient %}
@supports ((-webkit-background-clip: text) or (background-clip: text)) {
    #{{ sectionId }}.typography strong {
        background: {{ highlightGradient }};
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
    }
}
{%- endif %}

#{{ sectionId }}.typography a {
    color: inherit;
}

{% if enableTextGradient %}
#{{ sectionId }}.typography,
#{{ sectionId }}.typography p {
    background: {{ gradientColor }};
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
{% endif %}
{% endstyle %}

<div id="{{ sectionId }}" class="typography" {{ block.shopify_attributes }}>
    {{ settings.content }}
</div>

{% schema %}
{
  "name": "Typography",
  "settings": [
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_text_gradient",
      "label": "Enable Text Gradient",
      "default": false
