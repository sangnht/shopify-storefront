{% liquid 
    assign sectionId = section.id
    assign settings = block.settings
%}

{% stylesheet %}

{% endstylesheet %}

<div id="{{ sectionId }}">This is Content and Media Block</div>

{% schema %}
{
  "name": "Content and media",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Write something here...</p>"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "media",
      "label": "Image"
    }
  ],
    "presets": [
        {
        "name": "Content and media",
        "category": "Custom"
        }
    ]
}
{% endschema %}