{% liquid
    assign blockId = block.id
    assign settings = block.settings

    assign label = settings.label | default: 'Learn more'
    assign link = settings.link
    assign openInNewTab = settings.open_in_new_tab
    assign alignment = settings.alignment | default: 'left'

    assign textColor = settings.text_color | default: '#1a1a1a'
    assign hoverColor = settings.hover_color | default: '#000000'
    assign fontSizeDesktop = settings.font_size_desktop | default: 16
    assign fontSizeMobile = settings.font_size_mobile | default: 15
    assign fontWeight = settings.font_weight | default: 500
    assign letterSpacing = settings.letter_spacing | default: 0
    if settings.font_style_italic
        assign fontStyleItalic = 'italic'
    else
        assign fontStyleItalic = 'normal'
    endif

    assign underlineStyle = settings.underline_style | default: 'slide_left'
    assign underlineThickness = settings.underline_thickness | default: 1
    assign underlineOffset = settings.underline_offset | default: 3
    assign animationDuration = settings.animation_duration | default: 250
    assign arrow = settings.arrow | default: 'none'

    case alignment
        when 'center'
            assign justifyContent = 'center'
        when 'right'
            assign justifyContent = 'flex-end'
        else
            assign justifyContent = 'flex-start'
    endcase
%}

{% style %}
#{{ blockId }}.hyperlink {
    --hyperlink-duration: {{ animationDuration }}ms;
    --hyperlink-ease: cubic-bezier(0.33, 1, 0.68, 1);
    display: flex;
    justify-content: {{ justifyContent }};
}

#{{ blockId }} .hyperlink__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding-bottom: {{ underlineOffset }}px;
    font-size: {{ fontSizeDesktop }}px;
    font-weight: {{ fontWeight }};
    font-style: {{ fontStyleItalic }};
    letter-spacing: {{ letterSpacing }}px;
    line-height: 1.3;
    color: {{ textColor }};
    text-decoration: none;
    cursor: pointer;
    transition: color var(--hyperlink-duration) var(--hyperlink-ease);
}

#{{ blockId }} .hyperlink__text {
    position: relative;
}

#{{ blockId }} .hyperlink__text::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: {{ underlineThickness }}px;
    background-color: currentColor;
    transform-origin: left center;
    transition: transform var(--hyperlink-duration) var(--hyperlink-ease),
        opacity var(--hyperlink-duration) var(--hyperlink-ease);
    {%- case underlineStyle -%}
        {%- when 'always' -%}
            transform: scaleX(1);
        {%- when 'fade' -%}
            transform: scaleX(1);
            opacity: 0;
        {%- when 'slide_center' -%}
            transform: scaleX(0);
            transform-origin: center;
        {%- when 'none' -%}
            display: none;
        {%- else -%}
            transform: scaleX(0);
    {%- endcase -%}
}

#{{ blockId }} .hyperlink__link:not(.hyperlink__link--disabled):hover,
#{{ blockId }} .hyperlink__link:not(.hyperlink__link--disabled):focus-visible {
    color: {{ hoverColor }};
}

#{{ blockId }} .hyperlink__link:not(.hyperlink__link--disabled):hover .hyperlink__text::after,
#{{ blockId }} .hyperlink__link:not(.hyperlink__link--disabled):focus-visible .hyperlink__text::after {
    transform: scaleX(1);
    opacity: 1;
}

#{{ blockId }} .hyperlink__link:focus-visible {
    outline: 0.2rem solid currentColor;
    outline-offset: 0.3rem;
}

#{{ blockId }} .hyperlink__arrow {
    display: inline-flex;
    flex: 0 0 auto;
    transition: transform var(--hyperlink-duration) var(--hyperlink-ease);
}

#{{ blockId }} .hyperlink__arrow svg {
    display: block;
    width: 0.9em;
    height: 0.9em;
}

#{{ blockId }} .hyperlink--arrow-right .hyperlink__link:not(.hyperlink__link--disabled):hover .hyperlink__arrow,
#{{ blockId }} .hyperlink--arrow-right .hyperlink__link:not(.hyperlink__link--disabled):focus-visible .hyperlink__arrow {
    transform: translateX(0.25em);
}

#{{ blockId }} .hyperlink--arrow-up_right .hyperlink__link:not(.hyperlink__link--disabled):hover .hyperlink__arrow,
#{{ blockId }} .hyperlink--arrow-up_right .hyperlink__link:not(.hyperlink__link--disabled):focus-visible .hyperlink__arrow {
    transform: translate(0.15em, -0.15em);
}

#{{ blockId }} .hyperlink__link--disabled {
    cursor: default;
}

@media screen and (max-width: 749px) {
    #{{ blockId }} .hyperlink__link {
        font-size: {{ fontSizeMobile }}px;
    }
}

@media (prefers-reduced-motion: reduce) {
    #{{ blockId }} .hyperlink__link,
    #{{ blockId }} .hyperlink__text::after,
    #{{ blockId }} .hyperlink__arrow {
        transition: none;
    }
}
{% endstyle %}

<div
    id="{{ blockId }}"
    class="hyperlink hyperlink--underline-{{ underlineStyle }} hyperlink--arrow-{{ arrow }}"
    {{ block.shopify_attributes }}
>
    {%- if link != blank -%}
        <a
            class="hyperlink__link"
            href="{{ link }}"
            {%- if openInNewTab %} target="_blank" rel="noopener noreferrer"{% endif %}
        >
    {%- else -%}
        <span class="hyperlink__link hyperlink__link--disabled">
    {%- endif -%}

    <span class="hyperlink__text">{{ label }}</span>

    {%- if arrow != 'none' -%}
        <span class="hyperlink__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                {%- if arrow == 'up_right' -%}
                    <path d="M7 17L17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                {%- else -%}
                    <path d="M4 12h16M14 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                {%- endif -%}
            </svg>
        </span>
    {%- endif -%}

    {%- if link != blank -%}
        </a>
    {%- else -%}
        </span>
    {%- endif -%}
</div>

{% schema %}
{
  "name": "Hyperlink",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Without a link the text still previews in the editor, but it isn't clickable."
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in a new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font size (desktop)",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size (mobile)",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "font_weight",
      "label": "Font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "font_style_italic",
      "label": "Italic",
      "default": false
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -5,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Text color on hover",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Hover animation"
    },
    {
      "type": "select",
      "id": "underline_style",
      "label": "Underline",
      "options": [
        {
          "value": "slide_left",
          "label": "Slide in from left"
        },
        {
          "value": "slide_center",
          "label": "Grow from center"
        },
        {
          "value": "fade",
          "label": "Fade in"
        },
        {
          "value": "always",
          "label": "Always visible"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "slide_left"
    },
    {
      "type": "range",
      "id": "underline_thickness",
      "label": "Underline thickness",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.underline_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "underline_offset",
      "label": "Underline distance",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "select",
      "id": "arrow",
      "label": "Arrow",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "up_right",
          "label": "Up right"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Animation speed",
      "min": 100,
      "max": 600,
      "step": 50,
      "unit": "ms",
      "default": 250
    }
  ],
  "presets": [
    {
      "name": "Hyperlink",
      "category": "Custom",
      "settings": {
        "label": "Learn more",
        "open_in_new_tab": false,
        "alignment": "left",
        "font_size_desktop": 16,
        "font_size_mobile": 15,
        "font_weight": 500,
        "font_style_italic": false,
        "letter_spacing": 0,
        "text_color": "#1a1a1a",
        "hover_color": "#000000",
        "underline_style": "slide_left",
        "underline_thickness": 1,
        "underline_offset": 3,
        "arrow": "none",
        "animation_duration": 250
      }
    }
  ]
}
{% endschema %}
