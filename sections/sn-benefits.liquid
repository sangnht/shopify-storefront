{% liquid
    assign settings = section.settings
%}

{% style %}
#shopify-section-{{ section.id }} .sn-benefits {
    background: {{ settings.background }};
    padding: {{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px;
    color: #241333;
}

#shopify-section-{{ section.id }} .sn-benefits__inner {
    max-width: {{ settings.max_width }}px;
    margin: 0 auto;
}

#shopify-section-{{ section.id }} .sn-benefits__heading {
    text-align: center;
}

#shopify-section-{{ section.id }} .sn-benefits__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 40px;
}

#shopify-section-{{ section.id }} .sn-benefits__grid .media-block {
    width: 100%;
    border: 1px solid #eadff5;
}

#shopify-section-{{ section.id }} .sn-benefits__cta {
    display: flex;
    justify-content: center;
    margin-top: 40px;
}

@media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sn-benefits__grid {
        grid-template-columns: repeat(3, 1fr);
    }
}
{% endstyle %}

<div class="sn-benefits">
    <div class="sn-benefits__inner">
        <div class="sn-benefits__heading">
            {% content_for 'block', type: 'heading', id: 'benefits-heading' %}
        </div>

        <div class="sn-benefits__grid">
            {% content_for 'blocks' %}
        </div>

        <div class="sn-benefits__cta">
            {% content_for 'block', type: 'button', id: 'benefits-cta' %}
        </div>
    </div>
</div>

