{% liquid
    assign settings = section.settings
%}

{% style %}
#shopify-section-{{ section.id }} .sn-steps {
    background: {{ settings.background }};
    padding: {{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px;
    color: #241333;
}

#shopify-section-{{ section.id }} .sn-steps__inner {
    max-width: {{ settings.max_width }}px;
    margin: 0 auto;
}

#shopify-section-{{ section.id }} .sn-steps__heading {
    text-align: center;
}

#shopify-section-{{ section.id }} .sn-steps__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-top: 40px;
}

#shopify-section-{{ section.id }} .sn-steps__grid .media-block {
    width: 100%;
}

@media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sn-steps__grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 48px;
    }
}
{% endstyle %}

<div class="sn-steps">
    <div class="sn-steps__inner">
        <div class="sn-steps__heading">
            {% content_for 'block', type: 'heading', id: 'steps-heading' %}
        </div>

        <div class="sn-steps__grid">
            {% content_for 'blocks' %}
        </div>
    </div>
</div>

