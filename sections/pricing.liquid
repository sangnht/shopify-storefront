{% liquid
    assign settings = section.settings
%}

{% style %}
#shopify-section-{{ section.id }} .sn-pricing {
    background: {{ settings.background }};
    padding: {{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px;
    color: #ffffff;
}

#shopify-section-{{ section.id }} .sn-pricing__inner {
    max-width: {{ settings.max_width }}px;
    margin: 0 auto;
    text-align: center;
}

#shopify-section-{{ section.id }} .sn-pricing__eyebrow .typography {
    color: #f0b429;
}

#shopify-section-{{ section.id }} .sn-pricing__heading {
    margin-top: 8px;
}

#shopify-section-{{ section.id }} .sn-pricing__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 560px;
    margin: 32px auto 0;
    padding: 40px 32px 28px;
    background: #ffffff;
    border-radius: 24px;
    color: #241333;
    text-align: center;
}

#shopify-section-{{ section.id }} .sn-pricing__card .button-block {
    justify-content: center;
}

#shopify-section-{{ section.id }} .sn-pricing__legal {
    margin-top: 4px;
}

#shopify-section-{{ section.id }} .sn-pricing__legal .typography {
    color: #6e5c7a;
}
{% endstyle %}

<div class="sn-pricing">
    <div class="sn-pricing__inner">
        <div class="sn-pricing__eyebrow">
            {% content_for 'block', type: 'typography', id: 'pricing-eyebrow' %}
        </div>

        <div class="sn-pricing__heading">
            {% content_for 'block', type: 'heading', id: 'pricing-heading' %}
        </div>

        <div class="sn-pricing__card">
            {% content_for 'blocks' %}

            <div class="sn-pricing__legal">
                {% content_for 'block', type: 'typography', id: 'pricing-legal' %}
            </div>
        </div>
    </div>
</div>

