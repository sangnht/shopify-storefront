{% liquid
    assign settings = section.settings
%}

{% style %}
#shopify-section-{{ section.id }} .sn-products {
    background: {{ settings.background }};
    padding: {{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px;
    color: #241333;
}

#shopify-section-{{ section.id }} .sn-products__inner {
    max-width: {{ settings.max_width }}px;
    margin: 0 auto;
}

#shopify-section-{{ section.id }} .sn-products__heading {
    text-align: center;
}

#shopify-section-{{ section.id }} .sn-products__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 40px;
}

#shopify-section-{{ section.id }} .sn-products__grid .product-block {
    height: 100%;
    overflow: hidden;
    gap: 0;
}

#shopify-section-{{ section.id }} .sn-products__grid .product-block__info {
    padding: 24px;
}

#shopify-section-{{ section.id }} .sn-products__copy {
    max-width: 720px;
    margin: 40px auto 0;
    text-align: center;
}

#shopify-section-{{ section.id }} .sn-products__description .typography {
    color: #241333;
}

#shopify-section-{{ section.id }} .sn-products__note {
    margin-top: 8px;
}

#shopify-section-{{ section.id }} .sn-products__note .typography {
    color: #6e5c7a;
}

#shopify-section-{{ section.id }} .sn-products__cta {
    display: flex;
    justify-content: center;
    margin-top: 24px;
}

@media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sn-products__grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .sn-products__grid {
        grid-template-columns: repeat(3, 1fr);
    }
}
{% endstyle %}

<div class="sn-products">
    <div class="sn-products__inner">
        <div class="sn-products__heading">
            {% content_for 'block', type: 'heading', id: 'products-heading' %}
        </div>

        <div class="sn-products__grid">
            {% content_for 'blocks' %}
        </div>

        <div class="sn-products__copy">
            <div class="sn-products__description">
                {% content_for 'block', type: 'typography', id: 'products-description' %}
            </div>
            <div class="sn-products__note">
                {% content_for 'block', type: 'typography', id: 'products-note' %}
            </div>
        </div>

        <div class="sn-products__cta">
            {% content_for 'block', type: 'button', id: 'products-cta' %}
        </div>
    </div>
</div>

