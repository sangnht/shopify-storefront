{% liquid
    assign settings = section.settings
    assign halfGap = settings.column_gap | divided_by: 2.0

    case settings.vertical_alignment
        when 'top'
            assign alignItems = 'flex-start'
        when 'bottom'
            assign alignItems = 'flex-end'
        else
            assign alignItems = 'center'
    endcase
%}

{% style %}
#shopify-section-{{ section.id }} .sn-hero {
    background: {{ settings.background }};
    padding: {{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px;
    color: #ffffff;
}

#shopify-section-{{ section.id }} .sn-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: {{ settings.max_width }}px;
    margin: 0 auto;
}

#shopify-section-{{ section.id }} .sn-hero__heading {
    margin: 0;
}

#shopify-section-{{ section.id }} .sn-hero__description {
    margin-top: 24px;
    max-width: 560px;
}

#shopify-section-{{ section.id }} .sn-hero__description .typography p {
    margin: 0;
}

#shopify-section-{{ section.id }} .sn-hero__checks {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 28px;
}

#shopify-section-{{ section.id }} .sn-hero__cta {
    margin-top: 32px;
}

#shopify-section-{{ section.id }} .sn-hero__cta .button-block {
    justify-content: flex-start;
}

#shopify-section-{{ section.id }} .sn-hero__legal {
    margin-top: 20px;
}

#shopify-section-{{ section.id }} .sn-hero__legal .typography {
    color: #e9e1f2;
    opacity: 0.8;
}

#shopify-section-{{ section.id }} .sn-hero__legal .typography a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
}

#shopify-section-{{ section.id }} .sn-hero__media .image-block__media {
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.32);
}

#shopify-section-{{ section.id }} .sn-hero__highlight {
    margin-top: 28px;
}

#shopify-section-{{ section.id }} .sn-hero__highlight .typography {
    color: #ffffff;
}

#shopify-section-{{ section.id }} .sn-hero__highlight .typography strong {
    font-size: 1.8em;
}

#shopify-section-{{ section.id }} .sn-hero__rating {
    margin-top: 20px;
}

@media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sn-hero__inner {
        flex-direction: row;
        align-items: {{ alignItems }};
        gap: {{ settings.column_gap }}px;
    }

    #shopify-section-{{ section.id }} .sn-hero__content {
        flex: 0 0 calc({{ settings.content_width }}% - {{ halfGap }}px);
        min-width: 0;
    }

    #shopify-section-{{ section.id }} .sn-hero__aside {
        flex: 1 1 0;
        min-width: 0;
    }

    {%- if settings.media_position == 'left' %}
        #shopify-section-{{ section.id }} .sn-hero__content {
            order: 2;
        }

        #shopify-section-{{ section.id }} .sn-hero__aside {
            order: 1;
        }
    {%- endif %}
}

@media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sn-hero {
        padding: 40px 20px 44px;
    }

    #shopify-section-{{ section.id }} .sn-hero__inner {
        gap: 0;
    }

    /* Promote children so they can be interleaved in the mobile order. */
    #shopify-section-{{ section.id }} .sn-hero__content,
    #shopify-section-{{ section.id }} .sn-hero__aside {
        display: contents;
    }

    #shopify-section-{{ section.id }} .sn-hero__heading {
        order: 1;
    }

    #shopify-section-{{ section.id }} .sn-hero__description {
        order: 2;
        margin-top: 20px;
    }

    #shopify-section-{{ section.id }} .sn-hero__media {
        order: 3;
        margin-top: 24px;
    }

    #shopify-section-{{ section.id }} .sn-hero__checks {
        order: 4;
    }

    #shopify-section-{{ section.id }} .sn-hero__cta {
        order: 5;
        margin-top: 32px;
    }

    #shopify-section-{{ section.id }} .sn-hero__highlight {
        order: 6;
        margin-top: 32px;
    }

    #shopify-section-{{ section.id }} .sn-hero__rating {
        order: 7;
    }

    #shopify-section-{{ section.id }} .sn-hero__legal {
        order: 8;
        margin-top: 24px;
    }

    /* Mobile-specific styling from the design. */
    #shopify-section-{{ section.id }} .sn-hero__cta .button-block__cta {
        width: 100%;
    }

    #shopify-section-{{ section.id }} .sn-hero__highlight .typography {
        text-align: center;
        padding: 20px 24px;
    }

    #shopify-section-{{ section.id }} .sn-hero__rating .rating-block {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-align: center;
    }

    #shopify-section-{{ section.id }} .sn-hero__legal .typography {
        text-align: left;
    }
}
{% endstyle %}

<div class="sn-hero">
    <div class="sn-hero__inner">
        <div class="sn-hero__content">
            <div class="sn-hero__heading">
                {% content_for 'block', type: 'heading', id: 'hero-heading' %}
            </div>

            <div class="sn-hero__description">
                {% content_for 'block', type: 'typography', id: 'hero-description' %}
            </div>

            {%- if section.blocks.size > 0 -%}
                <div class="sn-hero__checks">
                    {% content_for 'blocks' %}
                </div>
            {%- endif -%}

            <div class="sn-hero__cta">
                {% content_for 'block', type: 'button', id: 'hero-cta' %}
            </div>

            <div class="sn-hero__legal">
                {% content_for 'block', type: 'typography', id: 'hero-legal' %}
            </div>
        </div>

        <div class="sn-hero__aside">
            <div class="sn-hero__media">
                {% content_for 'block', type: 'image', id: 'hero-image' %}
            </div>

            <div class="sn-hero__highlight">
                {% content_for 'block', type: 'typography', id: 'hero-highlight' %}
            </div>

            <div class="sn-hero__rating">
                {% content_for 'block', type: 'rating', id: 'hero-rating' %}
            </div>
        </div>
    </div>
</div>

